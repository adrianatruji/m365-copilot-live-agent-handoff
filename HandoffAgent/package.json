{
  "name": "handoff-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Custom engine agent for Microsoft 365 Copilot that fronts a Copilot Studio agent and hands conversations off to a live agent.",
  "main": "src/index.js",
  "scripts": {
    "login": "node --env-file=.env src/login.js",
    "start": "node --env-file=.env src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@microsoft/agents-activity": "^1.9.1",
    "@microsoft/agents-copilotstudio-client": "^1.9.1",
    "@microsoft/agents-hosting": "^1.9.1",
    "@microsoft/agents-hosting-express": "^1.9.1",
    "applicationinsights": "^3.17.0",
    "express": "^5.2.1"
  }
}
