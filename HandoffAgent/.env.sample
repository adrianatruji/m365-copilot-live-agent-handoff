PORT=3978

# Bot identity (Entra app registration used by the Azure Bot). setup.ps1 fills these in.
clientId=
clientSecret=
tenantId=

# Your Copilot Studio agent: Copilot Studio > your agent > Settings > Advanced > Metadata.
COPILOT_STUDIO_ENVIRONMENT_ID=
COPILOT_STUDIO_SCHEMA_NAME=

# Contoso Live Chat (mock contact center) running locally.
LIVE_CHAT_URL=http://localhost:5000
# Shared secret used to verify webhook calls from the live chat app. Must match ContosoLiveChat/.env.
WEBHOOK_SECRET=

# Return the user to the Copilot Studio agent if no human agent replies within this many minutes.
HANDOFF_TIMEOUT_MINUTES=5

# Optional (Option B): end-to-end telemetry. telemetry/enable-telemetry.ps1 fills this in. Leave empty to disable.
APPLICATIONINSIGHTS_CONNECTION_STRING=
