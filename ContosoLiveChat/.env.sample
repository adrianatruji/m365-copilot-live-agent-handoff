# Port for the live chat app (UI + API). It is bound to localhost only.
PORT=5000

# Where human agent replies are delivered (the HandoffAgent webhook).
HANDOFF_AGENT_WEBHOOK_URL=http://localhost:3978/api/livechat/messages

# Shared secret used to sign webhook calls (HMAC-SHA256). Must match HandoffAgent/.env.
# setup.ps1 generates one for you.
WEBHOOK_SECRET=
